# 本地源码联调入口：用相邻目录的 ai3d-core / ai3d-platform / ai3d-io 源码代替 vcpkg 端口。
# 正式构建走 vcpkg（见 vcpkg.json 与 CMakePresets.json）。
set(AI3D_WATERPOST_SIBLING_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/.." CACHE PATH "相邻 ai3d 源码根目录")
if(NOT TARGET ai3d_core::core)
    set(AI3D_CORE_INSTALL OFF)
    set(AI3D_CORE_WITH_TBB ON)
    add_subdirectory("${AI3D_WATERPOST_SIBLING_ROOT}/ai3d-core" "siblings/core")
endif()
if(NOT TARGET ai3d_platform::platform)
    set(AI3D_PLATFORM_INSTALL OFF)
    add_subdirectory("${AI3D_WATERPOST_SIBLING_ROOT}/ai3d-platform" "siblings/platform")
endif()
if(NOT TARGET ai3d_io::pack)
    set(AI3D_IO_INSTALL OFF)
    set(AI3D_IO_BUILD_TOOLS OFF)
    set(AI3D_IO_WITH_PACK ON)
    set(AI3D_IO_WITH_OPENCV ON)
    set(AI3D_IO_WITH_AT OFF)
    set(AI3D_IO_WITH_NODE OFF)
    add_subdirectory("${AI3D_WATERPOST_SIBLING_ROOT}/ai3d-io" "siblings/io")
endif()
